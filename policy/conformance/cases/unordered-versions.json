      "control": "malware",
      "verdict": "none",
      "want": {"effect": "block", "rule_id": "r_block_range"}
    },
    {
      "name": "block-range-outside",
      "package": {"ecosystem": "github-actions", "name": "evil/action", "version": "v5"},
      "control": "malware",
      "verdict": "none",
      "want": {"effect": "block", "rule_id": "r_block_range"}
    },
    {
      "name": "block-version-same-tag",
