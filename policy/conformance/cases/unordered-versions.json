      "control": "malware",
      "verdict": "none",
      "want": {"effect": "block", "rule_id": "r_block_version"}
    },
    {
      "name": "block-version-other-tag",
      "package": {"ecosystem": "github-actions", "name": "pinned/action", "version": "v3"},
      "control": "malware",
